{
	"name": "coliving",
	"author": {
		"name": "Sarvex Jatasra",
		"email": "sarvex@jatasra.com",
		"url": "https://jatasra.com"
	},
	"homepage": "https://coliving.ai",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@mui/material": "7.3.4",
		"@mui/icons-material": "7.3.4",
		"@types/googlemaps": "3.43.3",
		"@types/jest": "30.0.0",
		"@types/markerclustererplus": "2.1.33",
		"@types/node": "22.18.10",
		"@types/prop-types": "15.7.15",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"animate.css": "4.1.1",
		"apollo-boost": "0.4.9",
		"classnames": "2.5.1",
		"enzyme": "3.11.0",
		"eslint-import-resolver-babel-module": "5.3.2",
		"firebase": "12.4.0",
		"graphql": "16.11.0",
		"graphql-tag": "2.12.6",
		"history": "5.3.0",
		"mobx": "6.15.0",
		"moment": "2.30.1",
		"node-sass": "9.0.0",
		"nouislider": "15.8.1",
		"prop-types": "15.8.1",
		"react": "19.2.8",
		"react-animate-on-scroll": "2.1.9",
		"react-apollo": "3.1.5",
		"react-datetime": "3.3.1",
		"react-dom": "19.2.8",
		"react-google-maps": "9.4.5",
		"react-image-gallery": "1.4.0",
		"react-intl": "7.1.14",
		"react-router": "7.9.4",
		"react-router-dom": "7.18.3",
		"react-router-sitemap": "1.2.0",
		"react-scripts": "5.0.1",
		"react-slick": "0.31.0",
		"react-swipeable-views": "0.14.2",
		"react-tagsinput": "3.20.3",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@babel/cli": "7.28.3",
		"@babel/core": "7.28.4",
		"@babel/preset-env": "7.28.3",
		"@babel/preset-react": "7.27.1",
		"babel-loader": "10.0.0",
		"core-js": "3.46.0",
		"eslint": "9.37.0",
		"eslint-config-airbnb": "19.0.4",
		"eslint-config-prettier": "10.1.8",
		"eslint-loader": "4.0.2",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-prettier": "5.5.4",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-react": "7.37.5",
		"prettier": "3.6.2",
		"prettier-eslint": "16.4.2",
		"prettier-eslint-cli": "8.0.1"
	},
	"scripts": {
		"start": "react-scripts start",
		"build": "react-scripts build",
		"test": "react-scripts test",
		"eject": "react-scripts eject",
		"lint": "eslint . --ext=js,jsx --fix; exit 0",
		"fix-code": "prettier-eslint --write 'src/**/*.{js,jsx}' ",
		"fix-styles": "prettier-stylelint --write 'src/**/*.{css,scss}' ",
		"clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start"
	},
	"babel": {
		"presets": [
			"@babel/preset-env",
			"@babel/preset-react"
		]
	},
	"eslintConfig": {
		"root": true,
		"parser": "babel-eslint",
		"env": {
			"browser": true,
			"node": true,
			"es6": true
		},
		"globals": {
			"use": true
		},
		"parserOptions": {
			"ecmaVersion": 6,
			"sourceType": "module",
			"ecmaFeatures": {
				"jsx": true
			}
		},
		"extends": [
			"airbnb",
			"prettier",
			"prettier/react",
			"react-app"
		],
		"plugins": [
			"prettier",
			"react"
		],
		"rules": {
			"implicit-arrow-linebreak": "off",
			"comma-dangle": "off",
			"indent": "off",
			"no-trailing-spaces": "off",
			"no-param-reassign": "off"
		},
		"settings": {
			"import/resolver": {
				"node": {
					"paths": [
						"src"
					]
				}
			}
		}
	},
	"prettier": {
		"tabWidth": 2,
		"printWidth": 120,
		"singleQuote": true,
		"jsxSingleQuote": true,
		"semi": false,
		"useTabs": false,
		"trailingComma": "es5",
		"bracketSpacing": true,
		"jsxBracketSameLine": true,
		"arrowParens": "always",
		"endOfLine": "cr"
	},
	"engines": {
		"node": "22.x",
		"npm": "11.x"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
